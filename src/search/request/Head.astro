---
/**
 * The top of the search page: the <h1>, the line under it and the form. With `count` (a string, "" for none yet) that
 * line is the result count, in a live region, and the intro when there is none.
 */
import SearchForm from "@astronomic/theme-core/components/SearchForm.astro";
import { strings } from "~/theme.strings";
import { searchHref } from "~/utils/routes";

interface Props {
	count?: string;
}
const { count } = Astro.props;
const t = strings.search;
const live = count !== undefined;
---

<header class="v-page-head">
	<h1 class="m-0 v-display text-v-page">{t.title}</h1>
	<p data-head-lead data-count-text={live || undefined} aria-live={live ? "polite" : undefined} class="m-0 max-w-lead text-v-lead text-v-body text-pretty">
		{count || t.intro}
	</p>
	<SearchForm variant="row" action={searchHref()} strings={t.form} class="mt-10" />
</header>
